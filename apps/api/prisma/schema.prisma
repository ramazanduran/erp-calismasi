generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-TENANT: Organization (Tenant)
// ─────────────────────────────────────────────────────────────────────────────
model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  logoUrl     String?  @map("logo_url")
  domain      String?  @db.VarChar(255)
  plan        String   @default("free") @db.VarChar(50)
  settings    Json     @default("{}")
  theme       Json     @default("{}")
  locale      String   @default("tr") @db.VarChar(10)
  timezone    String   @default("Europe/Istanbul") @db.VarChar(50)
  currency    String   @default("TRY") @db.VarChar(3)
  status      String   @default("active") @db.VarChar(20)
  trialEndsAt DateTime? @map("trial_ends_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  users             User[]
  roles             Role[]
  departments       Department[]
  entityDefinitions EntityDefinition[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  workflows         Workflow[]
  customers         Customer[]
  products          Product[]
  productCategories ProductCategory[]
  orders            Order[]
  invoices          Invoice[]
  stockMovements    StockMovement[]
  employees         Employee[]
  leaveRequests     LeaveRequest[]
  financialAccounts FinancialAccount[]
  transactions      Transaction[]
  suppliers         Supplier[]
  purchaseOrders    PurchaseOrder[]
  tasks             Task[]
  sequences         Sequence[]
  chartOfAccounts   ChartOfAccount[]
  journalEntries    JournalEntry[]
  performanceReviews PerformanceReview[]
  leads             Lead[]
  payrolls          Payroll[]
  stockCounts       StockCount[]
  priceLists        PriceList[]
  apiTokens         ApiToken[]
  budgets           Budget[]
  deals             Deal[]
  webhooks          Webhook[]
  exchangeRates     ExchangeRate[]
  projects          Project[]
  assetCategories   AssetCategory[]
  assets            Asset[]
  shipments         Shipment[]
  documentTemplates DocumentTemplate[]
  generatedDocuments GeneratedDocument[]
  savedReports      SavedReport[]
  qualityInspections QualityInspection[]
  jobPostings       JobPosting[]
  candidates        Candidate[]
  trainingPrograms  TrainingProgram[]
  contracts         Contract[]
  maintenanceRequests MaintenanceRequest[]
  workCenters       WorkCenter[]
  billsOfMaterial   BillOfMaterial[]
  productionOrders  ProductionOrder[]
  bankStatements    BankStatement[]
  kpiDefinitions    KpiDefinition[]
  calendarEvents    CalendarEvent[]
  salesQuotes       SalesQuote[]
  purchaseRequests  PurchaseRequest[]
  vehicles          Vehicle[]

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────
model User {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  email          String        @db.VarChar(255)
  passwordHash   String        @map("password_hash")
  firstName      String?       @map("first_name") @db.VarChar(100)
  lastName       String?       @map("last_name") @db.VarChar(100)
  avatarUrl      String?       @map("avatar_url")
  phone          String?       @db.VarChar(20)
  roleId         String?       @map("role_id") @db.Uuid
  departmentId   String?       @map("department_id") @db.Uuid
  locale         String        @default("tr") @db.VarChar(10)
  timezone       String?       @db.VarChar(50)
  lastLoginAt    DateTime?     @map("last_login_at") @db.Timestamptz
  status         String        @default("active") @db.VarChar(20)
  preferences    Json          @default("{}")
  twoFactorSecret String?      @map("two_factor_secret")
  twoFactorEnabled Boolean     @default(false) @map("two_factor_enabled")
  backupCodes    String[]      @map("backup_codes")
  oauthProviders Json          @default("[]") @map("oauth_providers")
  emailVerifiedAt DateTime?    @map("email_verified_at") @db.Timestamptz
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role?         @relation(fields: [roleId], references: [id])
  department   Department?   @relation(fields: [departmentId], references: [id])
  sessions     UserSession[]
  auditLogs    AuditLog[]    @relation("AuditUser")
  notifications Notification[]
  qualityInspections QualityInspection[]
  jobPostingsCreated JobPosting[]
  trainingPrograms   TrainingProgram[]   @relation("TrainingCreatedBy")
  trainingSessions   TrainingSession[]   @relation("TrainingTrainer")
  contractsOwned     Contract[]          @relation("ContractOwner")
  contractAmendments ContractAmendment[]
  maintenanceRequested MaintenanceRequest[] @relation("MaintenanceRequestedBy")
  maintenanceAssigned  MaintenanceRequest[] @relation("MaintenanceAssignedTo")
  maintenanceComments  MaintenanceComment[]
  productionOrders     ProductionOrder[]
  kpiOwned             KpiDefinition[]   @relation("KpiOwner")
  kpiValues            KpiValue[]
  calendarEventsCreated CalendarEvent[]  @relation("EventCreatedBy")
  eventAttendees       EventAttendee[]
  salesQuotesCreated   SalesQuote[]
  purchaseRequestsMade PurchaseRequest[] @relation("PRRequestedBy")
  purchaseRequestsApproved PurchaseRequest[] @relation("PRApprovedBy")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER SESSION
// ─────────────────────────────────────────────────────────────────────────────
model UserSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @map("refresh_token")
  deviceInfo   Json?    @map("device_info")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at") @db.Timestamptz
  isRevoked    Boolean  @default(false) @map("is_revoked")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// ROLE & PERMISSIONS
// ─────────────────────────────────────────────────────────────────────────────
model Role {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(100)
  slug           String   @db.VarChar(100)
  description    String?
  permissions    String[] // ["sales.read", "sales.write", "inventory.read"]
  isSystem       Boolean  @default(false) @map("is_system")
  parentId       String?  @map("parent_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Role?        @relation("RoleHierarchy", fields: [parentId], references: [id])
  children     Role[]       @relation("RoleHierarchy")
  users        User[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// DEPARTMENT
// ─────────────────────────────────────────────────────────────────────────────
model Department {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  code           String?  @db.VarChar(50)
  description    String?
  parentId       String?  @map("parent_id") @db.Uuid
  managerId      String?  @map("manager_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children     Department[] @relation("DeptHierarchy")
  users        User[]
  budgets      Budget[]
  jobPostings  JobPosting[]
  purchaseRequests PurchaseRequest[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("departments")
}

// ─────────────────────────────────────────────────────────────────────────────
// DYNAMIC ENTITY SYSTEM
// ─────────────────────────────────────────────────────────────────────────────
model EntityDefinition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  moduleId       String   @map("module_id") @db.VarChar(100)
  name           String   @db.VarChar(100)
  tableName      String   @map("table_name") @db.VarChar(100)
  displayName    Json     @map("display_name")
  icon           String?  @db.VarChar(50)
  description    Json?
  behaviors      Json     @default("{}")
  views          Json     @default("{}")
  lifecycle      Json     @default("{}")
  isSystem       Boolean  @default(false) @map("is_system")
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fields       FieldDefinition[]

  @@unique([organizationId, tableName])
  @@index([organizationId])
  @@map("entity_definitions")
}

model FieldDefinition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityId       String   @map("entity_id") @db.Uuid
  name           String   @db.VarChar(100)
  columnName     String   @map("column_name") @db.VarChar(100)
  displayName    Json     @map("display_name")
  fieldType      String   @map("field_type") @db.VarChar(50)
  required       Boolean  @default(false)
  uniqueField    Boolean  @default(false) @map("unique_field")
  defaultValue   Json?    @map("default_value")
  config         Json     @default("{}")
  visibility     Json     @default("{}")
  conditional    Json?
  computed       Json?
  sortOrder      Int      @default(0) @map("sort_order")
  isSystem       Boolean  @default(false) @map("is_system")
  status         String   @default("active") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  entity EntityDefinition @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@map("field_definitions")
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKFLOW
// ─────────────────────────────────────────────────────────────────────────────
model Workflow {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           Json
  description    Json?
  entityId       String?  @map("entity_id") @db.VarChar(100)
  triggerType    String   @map("trigger_type") @db.VarChar(50)
  trigger        Json
  nodes          Json     @default("[]")
  edges          Json     @default("[]")
  settings       Json     @default("{}")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  instances         WorkflowInstance[]

  @@index([organizationId])
  @@map("workflows")
}

model WorkflowInstance {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  entityType  String?  @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id") @db.Uuid
  status      String   @default("running") @db.VarChar(20)
  currentNode String?  @map("current_node") @db.VarChar(100)
  context     Json     @default("{}")
  startedAt   DateTime @default(now()) @map("started_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([entityType, entityId])
  @@map("workflow_instances")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────────────────────────────────────
model Notification {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  type           String   @db.VarChar(50)
  title          String
  body           String?
  data           Json?
  isRead         Boolean  @default(false) @map("is_read")
  readAt         DateTime? @map("read_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────
model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  entityType     String?  @map("entity_type") @db.VarChar(100)
  entityId       String?  @map("entity_id") @db.Uuid
  action         String   @db.VarChar(20)
  changes        Json?
  metadata       Json?
  ipAddress      String?  @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AuditUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// SALES MODULE
// ─────────────────────────────────────────────────────────────────────────────
model Customer {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(255)
  email          String?  @db.VarChar(255)
  phone          String?  @db.VarChar(30)
  taxNumber      String?  @map("tax_number") @db.VarChar(20)
  taxOffice      String?  @map("tax_office") @db.VarChar(100)
  address        Json?
  contactPerson  String?  @map("contact_person") @db.VarChar(255)
  type           String   @default("corporate") @db.VarChar(20)
  status         String   @default("active") @db.VarChar(20)
  creditLimit    Decimal  @default(0) @map("credit_limit") @db.Decimal(15, 2)
  balance        Decimal  @default(0) @db.Decimal(15, 2)
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders       Order[]
  invoices     Invoice[]
  deals        Deal[]
  projects     Project[]
  shipments    Shipment[]
  contracts    Contract[]
  portalTokens CustomerPortalToken[]
  salesQuotes  SalesQuote[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customers")
}

model ProductCategory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(255)
  slug           String   @db.VarChar(100)
  parentId       String?  @map("parent_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children     ProductCategory[] @relation("CategoryHierarchy")
  products     Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("product_categories")
}

model Product {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  code           String   @db.VarChar(50)
  name           String   @db.VarChar(255)
  description    String?
  categoryId     String?  @map("category_id") @db.Uuid
  unit           String   @default("adet") @db.VarChar(20)
  purchasePrice  Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 2)
  salePrice      Decimal  @default(0) @map("sale_price") @db.Decimal(15, 2)
  vatRate        Decimal  @default(18) @map("vat_rate") @db.Decimal(5, 2)
  minStock       Decimal  @default(0) @map("min_stock") @db.Decimal(15, 3)
  currentStock   Decimal  @default(0) @map("current_stock") @db.Decimal(15, 3)
  imageUrl       String?  @map("image_url")
  barcode        String?  @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]
  stockMovements StockMovement[]
  qualityInspections QualityInspection[]
  billsOfMaterial    BillOfMaterial[]
  bomComponents      BOMItem[]           @relation("BOMComponent")
  productionOrders   ProductionOrder[]   @relation("ProductionOrderProduct")
  quoteItems         SalesQuoteItem[]
  purchaseRequestItems PurchaseRequestItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([barcode])
  @@map("products")
}

model Order {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  orderNumber    String    @map("order_number") @db.VarChar(50)
  customerId     String    @map("customer_id") @db.Uuid
  status         String    @default("draft") @db.VarChar(20)
  type           String    @default("sale") @db.VarChar(20)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  discountAmount Decimal   @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  netAmount      Decimal   @default(0) @map("net_amount") @db.Decimal(15, 2)
  currency       String    @default("TRY") @db.VarChar(3)
  notes          String?
  dueDate        DateTime? @map("due_date") @db.Timestamptz
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  invoices     Invoice[]
  shipments    Shipment[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  productId     String  @map("product_id") @db.Uuid
  quantity      Decimal @db.Decimal(15, 3)
  unitPrice     Decimal @map("unit_price") @db.Decimal(15, 2)
  discountRate  Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  taxRate       Decimal @default(18) @map("tax_rate") @db.Decimal(5, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Invoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  invoiceNumber  String    @map("invoice_number") @db.VarChar(50)
  customerId     String    @map("customer_id") @db.Uuid
  orderId        String?   @map("order_id") @db.Uuid
  type           String    @default("sale") @db.VarChar(20)
  status         String    @default("draft") @db.VarChar(20)
  totalAmount    Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  taxAmount      Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  netAmount      Decimal   @default(0) @map("net_amount") @db.Decimal(15, 2)
  currency       String    @default("TRY") @db.VarChar(3)
  issueDate      DateTime  @map("issue_date") @db.Timestamptz
  dueDate        DateTime? @map("due_date") @db.Timestamptz
  paidAt         DateTime? @map("paid_at") @db.Timestamptz
  notes          String?
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id])
  order        Order?        @relation(fields: [orderId], references: [id])
  items        InvoiceItem[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String  @map("invoice_id") @db.Uuid
  productId    String? @map("product_id") @db.Uuid
  description  String  @db.VarChar(500)
  quantity     Decimal @db.Decimal(15, 3)
  unitPrice    Decimal @map("unit_price") @db.Decimal(15, 2)
  discountRate Decimal @default(0) @map("discount_rate") @db.Decimal(5, 2)
  taxRate      Decimal @default(18) @map("tax_rate") @db.Decimal(5, 2)
  totalPrice   Decimal @map("total_price") @db.Decimal(15, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// INVENTORY MODULE
// ─────────────────────────────────────────────────────────────────────────────
model StockMovement {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  type           String    @db.VarChar(20)
  quantity       Decimal   @db.Decimal(15, 3)
  unitCost       Decimal?  @map("unit_cost") @db.Decimal(15, 2)
  reference      String?   @db.VarChar(100)
  notes          String?
  createdById    String    @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])

  @@index([organizationId])
  @@index([productId])
  @@map("stock_movements")
}

// ─────────────────────────────────────────────────────────────────────────────
// HR MODULE
// ─────────────────────────────────────────────────────────────────────────────
model Employee {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  userId           String?   @map("user_id") @db.Uuid
  employeeNumber   String    @map("employee_number") @db.VarChar(50)
  firstName        String    @map("first_name") @db.VarChar(100)
  lastName         String    @map("last_name") @db.VarChar(100)
  email            String    @db.VarChar(255)
  phone            String?   @db.VarChar(30)
  departmentId     String?   @map("department_id") @db.Uuid
  position         String?   @db.VarChar(100)
  startDate        DateTime  @map("start_date") @db.Timestamptz
  endDate          DateTime? @map("end_date") @db.Timestamptz
  salary           Decimal   @default(0) @db.Decimal(15, 2)
  salaryType       String    @default("monthly") @map("salary_type") @db.VarChar(20)
  status           String    @default("active") @db.VarChar(20)
  emergencyContact Json?     @map("emergency_contact")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  trainingEnrollments TrainingEnrollment[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@map("employees")
}

model LeaveRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  employeeId     String    @map("employee_id") @db.Uuid
  type           String    @db.VarChar(20)
  startDate      DateTime  @map("start_date") @db.Timestamptz
  endDate        DateTime  @map("end_date") @db.Timestamptz
  days           Decimal   @db.Decimal(5, 1)
  status         String    @default("pending") @db.VarChar(20)
  reason         String?
  approvedById   String?   @map("approved_by_id") @db.Uuid
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@map("leave_requests")
}

