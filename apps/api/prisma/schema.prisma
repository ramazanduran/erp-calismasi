  @@unique([kpiId, period])
  @@index([kpiId])
  @@map("kpi_values")
}

model KpiTarget {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kpiId    String   @map("kpi_id") @db.Uuid
  period   String   @db.VarChar(20)
  target   Decimal  @db.Decimal(18, 4)
