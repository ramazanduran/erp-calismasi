  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  quoteNumber    String   @map("quote_number") @db.VarChar(50)
  customerId     String   @map("customer_id") @db.Uuid
  status         String   @default("draft") @db.VarChar(20) // draft, sent, accepted, rejected, expired
  validUntil     DateTime? @map("valid_until") @db.Date
  subtotal       Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount    Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  currency       String   @default("TRY") @db.VarChar(3)
  notes          String?
  terms          String?
  createdById    String   @map("created_by_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid // when accepted, linked order
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer        @relation(fields: [customerId], references: [id])
  createdBy    User            @relation(fields: [createdById], references: [id])
  items        SalesQuoteItem[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, status])
  @@map("sales_quotes")
}

model SalesQuoteItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId     String   @map("quote_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(12, 4)
  unit        String   @default("adet") @db.VarChar(20)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(15, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2) // percentage
  vatRate     Decimal  @default(18) @map("vat_rate") @db.Decimal(5, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(15, 2)
  sortOrder   Int      @default(0) @map("sort_order")

  quote   SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@map("sales_quote_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// PURCHASE REQUESTS (Satın Alma Talepleri)
// ─────────────────────────────────────────────────────────────────────────────
model PurchaseRequest {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  requestNumber  String   @map("request_number") @db.VarChar(50)
  requestedById  String   @map("requested_by_id") @db.Uuid
  departmentId   String?  @map("department_id") @db.Uuid
  status         String   @default("draft") @db.VarChar(20) // draft, pending, approved, rejected, ordered, cancelled
  priority       String   @default("normal") @db.VarChar(20)
  neededBy       DateTime? @map("needed_by") @db.Date
  approvedById   String?  @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Timestamptz
  rejectedReason String?  @map("rejected_reason")
  notes          String?
  orderId        String?  @map("order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User                   @relation("PRRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?                  @relation("PRApprovedBy", fields: [approvedById], references: [id])
  department   Department?            @relation(fields: [departmentId], references: [id])
  items        PurchaseRequestItem[]

  @@unique([organizationId, requestNumber])
  @@index([organizationId, status])
  @@map("purchase_requests")
}

model PurchaseRequestItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId      String   @map("request_id") @db.Uuid
  productId      String?  @map("product_id") @db.Uuid
  description    String   @db.VarChar(500)
  quantity       Decimal  @db.Decimal(12, 4)
  unit           String   @default("adet") @db.VarChar(20)
  estimatedPrice Decimal? @map("estimated_price") @db.Decimal(15, 2)
  notes          String?

  request PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([requestId])
  @@map("purchase_request_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// VEHICLES (Araç Takibi)
// ─────────────────────────────────────────────────────────────────────────────
model Vehicle {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  plateNumber     String   @map("plate_number") @db.VarChar(20)
  brand           String   @db.VarChar(100)
  model           String   @db.VarChar(100)
  year            Int
  type            String   @default("truck") @db.VarChar(20) // truck, van, car, motorcycle
  status          String   @default("active") @db.VarChar(20) // active, maintenance, inactive
  fuelType        String   @default("diesel") @map("fuel_type") @db.VarChar(20)
  currentMileage  Int      @default(0) @map("current_mileage")
  nextServiceAt   Int?     @map("next_service_at") // km
  insuranceExpiry DateTime? @map("insurance_expiry") @db.Date
  inspectionExpiry DateTime? @map("inspection_expiry") @db.Date
  driverName      String?  @map("driver_name") @db.VarChar(255)
  notes           String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, plateNumber])
  @@index([organizationId])
  @@map("vehicles")
}
