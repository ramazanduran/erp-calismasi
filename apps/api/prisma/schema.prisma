// ─────────────────────────────────────────────────────────────────────────────
// CRM DEALS / OPPORTUNITIES (Satış Fırsatları)
// ─────────────────────────────────────────────────────────────────────────────
model Deal {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  title          String    @db.VarChar(255)
  customerId     String?   @map("customer_id") @db.Uuid
  leadId         String?   @map("lead_id") @db.Uuid
  assignedUserId String?   @map("assigned_user_id") @db.Uuid
  stage          String    @default("qualification") @db.VarChar(50)
  // qualification, proposal, negotiation, won, lost
  value          Decimal   @default(0) @db.Decimal(18, 2)
  currency       String    @default("TRY") @db.VarChar(3)
  probability    Int       @default(0) // 0-100
  expectedClose  DateTime? @map("expected_close") @db.Date
  closedAt       DateTime? @map("closed_at") @db.Timestamptz
  lostReason     String?   @map("lost_reason")
  description    String?
  tags           String[]
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lead         Lead?           @relation(fields: [leadId], references: [id])
  activities   DealActivity[]

  @@index([organizationId, stage])
  @@map("deals")
}

model DealActivity {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dealId      String   @map("deal_id") @db.Uuid
  type        String   @db.VarChar(30)  // call, email, meeting, note, task
